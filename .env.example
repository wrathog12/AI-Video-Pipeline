# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
# The pipeline loads `.env` automatically at startup.

# --- LLM annotation (Phase 2) ---
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- TTS ---
# Cartesia (primary once set): https://play.cartesia.ai/keys
# Without this, set providers.tts: edge-tts in config.yaml (free, no key).
CARTESIA_API_KEY=

# --- Optional alternates ---
# ANTHROPIC_API_KEY=
# ELEVENLABS_API_KEY=
