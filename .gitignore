# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Node / Remotion
node_modules/
remotion_engine/out/

# Generated artifacts.
# The cache directory structure is tracked (via .gitkeep) but its contents are not:
# cache entries are content-addressed derivatives, reproducible from the inputs.
.cache/**
!.cache/**/.gitkeep

output/**
!output/.gitkeep

# Exception: the scene spec generated for Script A is a required submission artifact (R6).
!output/script_a.spec.json

# Bundled fonts are committed deliberately — render-time font fetching is both a
# network dependency and a determinism hazard (see context.md, Stage 6). They live
# under public/ because staticFile() is the only way into the bundle: a font written
# to remotion_engine/fonts/ is one the renderer cannot open, and it fails silently as
# fallback typography. Re-fetch with `python -m python_pipeline.vendor_fonts`.
!remotion_engine/public/fonts/**

# Vendored Noto Emoji SVGs (Apache-2.0, ~2-40 KB each) are committed for the same
# reason as the fonts: a frame must be a function of the repository, not of
# GitHub's availability at render time. manifest.json records a SHA-256 per file so
# the committed bytes are auditable. Re-fetch with
# `python -m python_pipeline.assets.vendor_icons`.
!remotion_engine/public/icons/**

# Secrets
.env
.env.*
!.env.example

# Internal engineering report. Deliberately not published: it is a per-file,
# per-component walkthrough written for the author's own reference, and it names
# implementation detail (cache key composition, prompt structure, the exact
# whitelist the dashboard can write) that belongs in a working directory rather
# than on a public repo. README.md is the document that ships.
TECHNICAL_REPORT.md
